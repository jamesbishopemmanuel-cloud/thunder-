# Veylora Backend Configuration
# NEVER commit real secrets to the repository!
# Copy this file to .env and fill in actual values on your server only.

# Server
PORT=8080
NODE_ENV=development

# Frontend URL
CLIENT_URL=https://your-domain.example

# JWT Authentication
JWT_SECRET=CHANGE_ME_WITH_A_STRONG_SECRET
JWT_EXPIRES_IN=7d

# Database (PostgreSQL + Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/veylora

# Paystack Payment Processing
# DO NOT expose these on the frontend!
PAYSTACK_SECRET_KEY=CHANGE_ME_WITH_YOUR_PAYSTACK_SECRET
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_WEBHOOK_SECRET=CHANGE_ME_WITH_YOUR_WEBHOOK_SECRET

# Settlement Account (Configured server-side only)
# Account Name: Emmanuel Ebitari James
# Bank: Moniepoint MFB
# Account Number: Configured in Paystack dashboard, NOT here

# AI Services
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=CHANGE_ME_WITH_YOUR_AI_API_KEY

# WebRTC TURN Server (Optional)
TURN_URL=turn:your-turn-server.example
TURN_USERNAME=your-username
TURN_CREDENTIAL=your-credential

# Redis (Optional, for session management)
REDIS_URL=redis://localhost:6379

# Email Service (Optional, for notifications)
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=CHANGE_ME

# SMS Provider (Optional, for OTP)
SMS_PROVIDER=twilio
SMS_API_KEY=CHANGE_ME
SMS_ACCOUNT_SID=CHANGE_ME
